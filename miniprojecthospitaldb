create database hospitaldatabase;
select datname from pg_database;
create table department (
dep_id int primary key,
dep_name varchar(35)); 
create table doctors (
doc_id int primary key,
doc_name varchar(50),
dep_id int ,foreign key (dep_id) references department (dep_id),
salary decimal(10,2));
create table patients(
pat_id int primary key,
patient_name varchar(45),
gender varchar(10),
bloodgroup varchar(10),
disease varchar(45));
create table appointments(
appointment_id int,
doc_id int ,foreign key (doc_id) references doctors(doc_id),
pat_id int ,foreign key (pat_id) references patients(pat_id),
appointment_date date,
status varchar(34));
create table billing(
bill_id int,
pat_id int ,foreign key (pat_id) references patients (pat_id), 
doc_id int ,foreign key (doc_id) references doctors (doc_id),
bill_date date,
amount decimal(10,2),
paymentstatus varchar(40));
