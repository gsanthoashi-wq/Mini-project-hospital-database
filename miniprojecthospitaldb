select dep_id,count(*) as doccount from doctors group by dep_id having count(*) > 5;
select disease,count(*) as diseasecount from patients group by disease having count(*) >10;
select bloodgroup,count(*) as patientcount from patients group by bloodgroup having count(*)>15;
select doc_id,count(*) as patientcount from appointments group by doc_id having count(*)>10;
select doc_id,count(*) as appointmentcount from appointments group by doc_id having count(*)>20;
select dep_id,round (avg(salary)) as avgsalary from doctors group by dep_id having avg(salary) > 100000;   
select dep_id,sum(salary) from doctors group by dep_id having sum(salary) > 1000000;
select dep_id,max(salary) as highestsalary from doctors group by dep_id having max(salary) > 150000 order by max(salary) desc;
select dep_id,min(salary) as lowsalary from doctors group by dep_id having min(salary) > 80000 order by min(salary);
select medicine_id,medicine_name,sum(price) as totalsales from medicine group by medicine_id,medicine_name having sum(price) > 50000;
select doc_id,pat_id,sum(pat_id) as uniquepatient from appointments group by doc_id,pat_id order by sum(pat_id)desc;
select doc_id,count(distinct pat_id) as uniquepatient from appointments where status = 'Completed' group by doc_id having count(distinct pat_id) > 20;
select doc_id,round (avg(amount)) as avgpatientbill from billing group by doc_id having avg(amount) > 65000;
select disease,count(distinct patient_name) as patient from patients group by disease having count(distinct patient_name) > 5;
select doc_id,count(*) as completedappointment from appointments where status = 'Completed' group by doc_id having count(*) > 20;
select dep_id,count(*) as doccount, round (avg(salary)) from doctors group by dep_id having count(*) > 5 and avg(salary) > 100000; 
select date_trunc('month',bill_date) as month ,sum(amount) as revenue from billing group by date_trunc('month',bill_date) having sum(amount) > 500000 order by month;
select medicine_name,count(*) as medicinecount from medicine group by medicine_name having count(*) > 5;
select doc_id,sum(amount) as totalbill from billing group by doc_id having sum(amount) > 500000;
select count(patient_name) as patientcount from patients;
select count(doc_name) as doctorcount from doctors;
select sum(amount) as billingamount from billing;
select round (avg(amount)) as averagebillingamount from billing;
select pat_id,max(amount)as highestbill from billing group by pat_id order by max(amount) desc limit 1;
select pat_id,min(amount)as lowestbill from billing group by pat_id order by min(amount) limit 1;
select sum(price) as medicinesalaes from medicine;
select doc_name,max(salary) as highestsalary from doctors group by doc_name order by max(salary)desc limit 1;
select doc_name,min(salary) as lowestsalary from doctors group by doc_name order by min(salary) limit 1;
select gender,count(pat_id)as patient from patients group by gender;
select bloodgroup,count(pat_id) as patient from patients group by bloodgroup;
select dep_id,count(doc_name) as doctorcount from doctors group by dep_id order by dep_id;
select dep_id,avg(doc_name) as doctorcount from doctors group by dep_id order by dep_id;
select dep_id,round (avg(salary)) as avgsalary from doctors group by dep_id order by dep_id;
select dep_id,round (sum(salary)) as salary from doctors group by dep_id order by dep_id;
select dep_id,round (max(salary)) as maxsalary from doctors group by dep_id order by dep_id;
select dep_id,round (min(salary)) as minimumsalary from doctors group by dep_id order by dep_id;
select paymentstatus,sum(amount) as revenue from billing group by paymentstatus;
select status,count(appointment_date) as counts from appointments group by status;
select disease,count(patient_name) as patientcount from patients group by disease;
select dep_id,count(doc_name) as countdoctors from doctors group by dep_id having count(doc_name) > 5;
select doc_id,count(pat_id) as countpatient from billing group by doc_id having count(pat_id) >5;
select dep_id,round (avg(salary)) as avgsalary from doctors group by dep_id having avg(salary) > 100000;
select doc_id,sum(amount) as totalbilling from billing group by doc_id having sum(amount) > 500000;
select doc_id,count(pat_id) from appointments group by doc_id order by count(pat_id)desc limit 1;
select disease,count(disease) as counts from patients group by disease order by count(disease)desc limit 1;
select medicine_name,count(medicine_name) from medicine group by medicine_name order by count(medicine_name) desc limit 1;
select max(medicine_name),count(medicine_name) from medicine group by medicine_name order by count(medicine_name)desc limit 1;
select bill_date,max(amount) from billing group by bill_date order by max(amount) desc;
select d.doc_id,count(b.pat_id) as nopatientcount from doctors d full outer join appointments b on d.doc_id = b.doc_id group by d.doc_id having count(b.pat_id) < 1 order by doc_id;
select d.dep_id,sum(b.amount) as total from doctors d inner join billing b on d.doc_id = b.doc_id group by d.dep_id;
select pat_id,sum(medicineamount) as expenditure from appointments group by pat_id having sum(medicineamount) > 10000 order by sum(medicineamount) desc limit 1;
select d.dep_id,sum(b.amount) as totalrevenue from billing b inner join doctors d on d.doc_id = b.doc_id group by d.dep_id having sum(b.amount) > 1000000;
select d.dep_name,count(doc.doc_id) as doccount,round (avg(doc.salary)) as averagesalary,round (max(doc.salary)) as highestsalary,
min(doc.salary) as lowsalary,sum(doc.salary) as totalsalary from department d left join doctors doc on d.dep_id = doc.dep_id 
group by d.dep_name having count(doc.doc_id) > 2 and avg(doc.salary) > 100000 order by avg(doc.salary) desc;
